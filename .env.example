# Copy to .env and fill in real values. Never commit .env, the private key,
# or the signing key password to source control.
POS_LICENSE_ENVIRONMENT=production
POS_LICENSE_DEBUG=false
POS_LICENSE_ALLOWED_HOSTS=["ezpos.onrender.com"]
POS_LICENSE_PRODUCT=PharmaPOS
POS_LICENSE_PUBLIC_KEY_B64=replace-with-public-key-base64
# Render mounts an uploaded Secret File at /etc/secrets. Locally this path
# resolves to keys/private/license-signing-key.pem in this repository.
POS_LICENSE_SIGNING_PRIVATE_KEY_FILE=/etc/secrets/license-signing-key.pem
# Optional fallback when no Secret File is mounted:
# POS_LICENSE_SIGNING_PRIVATE_KEY_B64=replace-with-base64-encoded-encrypted-ed25519-private-key
POS_LICENSE_SIGNING_KEY_PASSWORD=replace-with-signing-key-password
POS_LICENSE_DATABASE_URL=sqlite+aiosqlite:///./data/licensing.db
